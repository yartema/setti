{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "setti": ["./node_modules/setti/src/index.ts"],
      "setti/server": ["./node_modules/setti/src/server.ts"],
      "setti/client": ["./node_modules/setti/src/client/index.ts"]
    }
