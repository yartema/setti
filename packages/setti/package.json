{
    "name": "setti",
    "version": "0.2.0-alpha.4",
    "type": "module",
    "description": "Fullstack React framework on React 19 + Fastify + Vite",
    "license": "MIT",
    "author": "yar.tema",
    "homepage": "https://github.com/yartema/nixo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yartema/nixo.git",
        "directory": "packages/nixo"
    },
    "bugs": {
        "url": "https://github.com/yartema/nixo/issues"
    },
    "keywords": [
        "react",
        "fastify",
        "vite",
        "ssr",
        "spa",
        "fullstack",
        "framework",
        "json-rpc",
        "nixo"
    ],
    "files": [
        "dist",
        "!dist/**/*.map",
        "bin",
        "README.md",
        "LICENSE"
    ],
    "bin": {
        "setti": "./bin/setti.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "pnpm build",
        "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md')\"",
        "publish:alpha": "pnpm --filter setti build && cd packages/setti && npm publish --tag alpha --access public && cd ../.. && npm dist-tag add setti@$(node -p \"require('./packages/setti/package.json').version\") alpha && npm dist-tag add setti@$(node -p \"require('./packages/setti/package.json').version\") latest"
    },
    "dependencies": {
        "@fastify/static": "^10.1.10",
        "devalue": "^6.0.3",
        "jiti": "^2.4.2"
    },
    "peerDependencies": {
        "@vitejs/plugin-react": "^6.3.0",
        "fastify": "^5.12.8",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vite": "^8.3.7"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.0",
        "fastify": "^5.12.8",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "publishConfig": {
        "access": "public",
        "tag": "alpha"
    }
}
