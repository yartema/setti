# Default: LF для всех текстовых файлов
* text=auto eol=lf

# Windows-only скрипты
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Скрипты (shebang)
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.sh    text eol=lf
bin/*   text eol=lf

# Бинарные — без конвертации
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
